@page
@model MovieAppsProject.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Users & Roles";
}

<h1 class="mb-3">Users &amp; Roles</h1>

<form method="get" class="row g-2 align-items-center mb-3">
    <div class="col-auto">
        <input name="Search" value="@Model.Search" class="form-control form-control-sm" placeholder="Search username or email" />
    </div>
    <div class="col-auto">
        <select name="PageSize" class="form-select form-select-sm" onchange="this.form.submit()">
            @{
                var sizes = new[] { 10, 20, 50, 100 };
                foreach (var s in sizes)
                {
                    <option value="@s" selected="@(Model.PageSize == s ? "selected" : null)">@s</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-sm btn-primary">Search</button>
    </div>
</form>

<div class="table-responsive">
<table class="table table-sm table-striped align-middle">
    <thead>
        <tr>
            <th style="width:60px;">#</th>
            <th>UserName</th>
            <th>Email</th>
            <th>Roles</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
    @if (Model.Users.Count == 0)
    {
        <tr><td colspan="4" class="text-muted">No users found.</td></tr>
    }
    else
    {
        for (var i = 0; i < Model.Users.Count; i++)
        {
            var u = Model.Users[i];
            <tr>
                <td>@(((Model.PageNumber - 1) * Model.PageSize) + i + 1)</td>
                <td>@u.UserName</td>
                <td>@u.Email</td>
                <td>@(u.Roles.Count > 0 ? string.Join(", ", u.Roles) : "-")</td>
                <td>
                    <a asp-page="/Admin/Users/EditRoles" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">
                        Edit Roles
                    </a>
                </td>
            </tr>
        }
    }
    </tbody>
</table>
</div>

@if (Model.TotalPages > 1)
{
    <nav aria-label="User pagination">
        <ul class="pagination pagination-sm">
            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : null)">
                <a class="page-link" href="?Search=@Model.Search&Page=@(Model.PageNumber-1)&PageSize=@Model.PageSize">Prev</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">
                    Page @Model.PageNumber of @Model.TotalPages
                </span>
            </li>
            <li class="page-item @(Model.PageNumber == Model.TotalPages ? "disabled" : null)">
                <a class="page-link" href="?Search=@Model.Search&Page=@(Model.PageNumber+1)&PageSize=@Model.PageSize">Next</a>
            </li>
        </ul>
    </nav>
}