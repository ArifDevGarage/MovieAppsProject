@page
@model MovieAppsProject.Areas.Cinema.Pages.RequestForm.CreateModel
@{
    ViewData["Title"] = "Create Movie";
}

<h1>Create Movie</h1>

<form method="post" class="mt-3">
    <div class="mb-3">
        <label asp-for="Input.Title" class="form-label"></label>
        <input asp-for="Input.Title" class="form-control" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Overview" class="form-label"></label>
        <textarea asp-for="Input.Overview" class="form-control" rows="3"></textarea>
    </div>

    <div class="row">
        <div class="col-md-4 mb-3">
            <label asp-for="Input.ReleaseDate" class="form-label"></label>
            <input asp-for="Input.ReleaseDate" type="date" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Input.RuntimeMinutes" class="form-label"></label>
            <input asp-for="Input.RuntimeMinutes" class="form-control" />
        </div>
        <div class="col-md-4 mb-3">
            <label asp-for="Input.Budget" class="form-label"></label>
            <input asp-for="Input.Budget" class="form-control" />
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Input.PosterUrl" class="form-label"></label>
        <input asp-for="Input.PosterUrl" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Genres</label>
        <div class="row row-cols-2 row-cols-md-3 g-2">
            @foreach (var g in Model.Genres)
            {
                <div class="col">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox"
                               name="Input.SelectedGenres" value="@g.Id" id="g-@g.Id" />
                        <label class="form-check-label" for="g-@g.Id">@g.Name</label>
                    </div>
                </div>
            }
        </div>
    </div>

    <button class="btn btn-primary">Create</button>
    <a asp-page="Index" class="btn btn-secondary">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}